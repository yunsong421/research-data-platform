# /etc/systemd/system/data-platform.service
#
# Install:
#   sudo cp deploy/data-platform.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now data-platform

[Unit]
Description=Data Management Platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/data-platform
Environment="DATA_DIR=/var/lib/data-platform"
Environment="APP_HOST=127.0.0.1"
Environment="APP_PORT=5000"
ExecStart=/opt/data-platform/.venv/bin/python /opt/data-platform/wsgi.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
